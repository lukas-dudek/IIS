# Lokální konfigurace a tajemství
/config/config.php
/config/config.local.php
.env
.env.*
!.env.example

# Composer – runtime ani dev vendor necommitovat
/vendor/
/composer.phar

# PHPUnit a nástroje
.phpunit.result.cache
.phpunit.cache/
/coverage/
/build/

# Laravel runtime – adresáře si drží vlastní .gitignore soubory
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore
/public/storage

# Logy a dočasné soubory
*.log

# Uživatelské uploady původní větve
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/.htaccess

# Odevzdávané archivy a lokální dumpy
/*.zip
*.dump
*.sql.gz

# OS a editory
.DS_Store
.idea/
.vscode/
*.swp
